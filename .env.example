# Credentials used ONLY by bootstrap_garmin_session.py to mint the Garmin
# OAuth token session (a roughly-yearly step). The bpo2g upload command itself
# never reads these — it authenticates from the persisted token store.
#
# Copy to .env and fill in, or supply them via a secrets manager, e.g.:
#   op run --env-file=.env -- uv run python bootstrap_garmin_session.py
GARMIN_USERNAME=you@example.com
GARMIN_PASSWORD=your-garmin-password

# Optional: override where the token session is written/read.
# Defaults to ~/.garminconnect (shared with the garminconnect convention).
# GARMINTOKENS=~/.garminconnect
